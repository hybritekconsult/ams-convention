# Copy this to .env on your cPanel server (in public_html/adorersnetherlands/)
# and fill in the real values.

# YouTube live stream ID — set when going live, leave empty otherwise
YOUTUBE_STREAM_ID=

# Admin panel password — change this to something secure
ADMIN_PASSWORD=change-me-before-going-live

# Node.js port (cPanel usually sets this automatically)
PORT=3000
